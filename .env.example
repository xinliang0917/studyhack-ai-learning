DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Embedding / Retrieval / RAG
# 设为 false 可跳过向量模型，仅用 BM25（低配/免费部署推荐）
EMBEDDING_ENABLED=true
# 中文资料推荐 BAAI/bge-small-zh-v1.5；也可用 paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 留空自动选择；可填 cpu / cuda
EMBEDDING_DEVICE=
# hybrid = BM25 + 向量 + RRF；也可设为 vector / bm25
RETRIEVAL_MODE=hybrid
# 可选重排，默认关闭；开启后会加载 CrossEncoder，首次较慢
RERANK_ENABLED=false
RERANK_MODEL=BAAI/bge-reranker-base
# 过滤过远检索片段，0 表示关闭绝对距离阈值
RAG_MAX_DISTANCE=1.6
# 多轮追问时先用 LLM 改写成独立检索问题
RAG_QUERY_REWRITE=true
MAX_UPLOAD_MB=50

# Rate limit
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=20

# OCR（扫描版 PDF，需要安装 requirements-ocr.txt）
OCR_ENABLED=false
OCR_MIN_TEXT=20

# ASR（FunASR HTTP 服务）
ASR_ENABLED=false
FUNASR_URL=http://localhost:10095/transcribe
ASR_TIMEOUT=120

# CORS 白名单，逗号分隔
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# LLM Provider: deepseek | ollama
LLM_PROVIDER=deepseek
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_API_KEY=ollama

# Face samples (default: backend/face_images, supports non-ASCII paths)
# FACE_IMAGES_DIR=

# Database (SQLite mode)
USE_SQLITE=true
SQLITE_PATH=ai_learning.db
# 首次启动写入演示账号 demo / demo123456 和示例数据
SEED_DEMO=false

# Database (MySQL mode - uncomment to use)
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=your-password
# DB_NAME=ai_learning_assistant
# USE_SQLITE=false

JWT_SECRET=change-this-to-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

SERVER_HOST=0.0.0.0
SERVER_PORT=8000
